# Copier en .env pour travailler en local (npm run dev).
# En production, ces lignes vont dans le secret GitHub ENV_FILE (voir DEPLOIEMENT.md).
# Pas de guillemets autour des valeurs.

# Adresse publique du site (sans / final) : liens canoniques et image de partage.
VITE_SITE_URL=https://koya.codetrine.com

# Lien affilié Woura (boutons « Créer mon compte Woura » et lien du pied de page).
# Format : https://woura.africa/?ref=VOTRE_CODE
VITE_WOURA_URL=https://woura.africa/?ref=VOTRE_CODE

# Numéro WhatsApp au format international, chiffres seuls (wa.me et lien d'appel).
VITE_WHATSAPP_NUMBER=2290152372194

# Le même numéro, tel qu'il s'affiche sur la page.
VITE_PHONE_DISPLAY=01 52 37 21 94
